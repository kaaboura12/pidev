    <!-- Quick View Modal -->
    <div class="modal fade" id="quickViewModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="text-center p-4">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Donation Modals -->
    {% for event in events %}
        <div class="modal fade" id="donationModal{{ event.idevent }}" tabindex="-1" aria-labelledby="donationModalLabel{{ event.idevent }}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="donationModalLabel{{ event.idevent }}">Make a Donation for {{ event.titre }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="{{ path('donation_payment', {'idevent': event.idevent}) }}" method="POST">
                        <div class="modal-body">
                            {% if app.user %}
                                <input type="hidden" name="user_id" value="{{ app.user.id }}">
                            {% endif %}
                            
                            <div class="mb-3">
                                <label for="donorname" class="form-label">Your Name</label>
                                <input type="text" class="form-control" id="donorname" name="donorname" 
                                       value="{{ app.user ? app.user.nom : '' }}" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="email" class="form-label">Email</label>
                                <input type="email" class="form-control" id="email" name="email" 
                                       value="{{ app.user ? app.user.email : '' }}" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="montant" class="form-label">Donation Amount ($)</label>
                                <input type="number" class="form-control" id="montant" name="montant" 
                                       min="1" step="0.01" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="num_tlf" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="num_tlf" name="num_tlf" required>
                            </div>
                            
                            <div class="mb-3">
                                <label for="payment_method" class="form-label">Payment Method</label>
                                <select class="form-select" id="payment_method" name="payment_method" required>
                                    <option value="credit_card">Credit Card</option>
                                    <option value="paypal">PayPal</option>
                                    <option value="bank_transfer">Bank Transfer</option>
                                </select>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Proceed to Payment</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endfor %}

    <!-- Add Reservation Modals -->
    {% for event in events %}
        <div class="modal fade" id="reservationModal{{ event.idevent }}" tabindex="-1" aria-labelledby="reservationModalLabel{{ event.idevent }}" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="reservationModalLabel{{ event.idevent }}">Reserve Tickets for {{ event.titre }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <form action="{{ path('add_reservation', {'idevent': event.idevent}) }}" method="POST">
                        <div class="modal-body">
                            {% if app.user %}
                                <input type="hidden" name="user_id" value="{{ app.user.id }}">
                            {% endif %}
                            
                            <div class="mb-3">
                                <label for="seats" class="form-label">Number of Seats</label>
                                <input type="number" class="form-control" id="seats" name="seats" 
                                       min="1" max="{{ event.nombreBillets }}" required>
                                <small class="text-muted">Available seats: {{ event.nombreBillets }}</small>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Price per Seat</label>
                                <p class="form-control-static">${{ event.seatprice|number_format(2) }}</p>
                            </div>
                            
                            <div class="mb-3">
                                <label class="form-label">Total Amount</label>
                                <p class="form-control-static" id="totalAmount{{ event.idevent }}">$0.00</p>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                            <button type="submit" class="btn btn-primary">Confirm Reservation</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    {% endfor %}

