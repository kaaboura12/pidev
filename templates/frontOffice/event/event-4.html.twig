                                    {% else %}
                                        <img src="{{ asset('assets/img/event/event-thumb-1-1.png') }}" alt="Default Event Image">
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12 text-center">
                            <p>No events found.</p>
                        </div>
                    {% endfor %}
