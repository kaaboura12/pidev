{% extends 'base.html.twig' %}

{% block title %}Modifier l'Offre d'Emploi{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4">Modifier l'Offre d'Emploi</h1>

        <div class="card shadow-sm">
            <div class="card-body">
                {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

                {# Les champs du formulaire #}
                <div class="form-group row">
                    {{ form_label(form.titre, 'Titre', {'label_attr': {'class': 'col-sm-2 col-form-label'}}) }}
                    <div class="col-sm-10">
                        {{ form_widget(form.titre, {'attr': {'class': 'form-control'}}) }}
                    </div>
                </div>

                {# Ajouter les autres champs ici #}

                <div class="form-group row">
                    <div class="col-sm-10 offset-sm-2">
                        <button type="submit" class="btn btn-warning">Modifier</button>
                        <a href="{{ path('user_emplois') }}" class="btn btn-secondary">Annuler</a>
                    </div>
                </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}