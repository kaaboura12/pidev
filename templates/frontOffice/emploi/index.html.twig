{% extends 'base.html.twig' %}

{% block title %}Liste des Offres d'Emploi{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1 class="mb-4 text-center fw-bold text-dark">Liste des Offres d'Emploi</h1>

        <div class="row">
            {% for emploi in emplois %}
                <div class="col-md-6 mb-4">
                    <div class="card h-100 border-0 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title fw-bold text-dark">{{ emploi.titre }}</h5>
                            <h6 class="card-subtitle mb-2 text-muted">{{ emploi.lieu }}</h6>
                            <p class="card-text text-secondary">{{ emploi.description|slice(0, 100) }}...</p>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="badge bg-primary">{{ emploi.statut }}</span>
                                <span class="text-muted">{{ emploi.datePublication|date('d/m/Y H:i') }}</span>
                            </div>
                            <div class="mt-3">
                                <strong>Compétences Requises :</strong> 
                                <span class="text-muted">{{ emploi.competencesRequises|slice(0, 50) }}...</span>
                            </div>
                            <div class="mt-2">
                                <strong>Budget :</strong> 
                                <span class="text-success fw-bold">{{ emploi.budget ? emploi.budget ~ ' DT' : 'Non spécifié' }}</span>
                            </div>
                        </div>
                        <div class="card-footer bg-white border-0">
                            <div class="d-flex justify-content-between">
                                <a href="{{ path('emploi_show', {'id': emploi.id}) }}" class="btn btn-sm btn-outline-dark">
                                    <i class="fas fa-eye"></i> Voir
                                </a>
                                {% if app.user and emploi.user == app.user %}
                                    <a href="{{ path('emploi_edit', {'id': emploi.id}) }}" class="btn btn-sm btn-outline-dark">
                                        <i class="fas fa-edit"></i> Modifier
                                    </a>
                                    <form action="{{ path('emploi_delete', {'id': emploi.id}) }}" method="post" style="display:inline;">
                                        <input type="hidden" name="_method" value="DELETE">
                                        <button type="submit" class="btn btn-sm btn-outline-dark" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cette offre ?')">
                                            <i class="fas fa-trash"></i> Supprimer
                                        </button>
                                    </form>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-light text-center border" role="alert">
                        <i class="fas fa-info-circle"></i> Aucune offre d'emploi trouvée.
                    </div>
                </div>
            {% endfor %}
        </div>

        <div class="mt-4 text-center">
            <a href="{{ path('emploi_add') }}" class="btn btn-lg btn-outline-dark">
                <i class="fas fa-plus"></i> Ajouter une Offre
            </a>
        </div>
    </div>
{% endblock %}