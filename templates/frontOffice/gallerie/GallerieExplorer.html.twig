{% extends 'base.html.twig' %}
{% block body %}
<!--==============================
    Product Lightbox
    ==============================-->
            
    <div id="smooth-wrapper">
        <div id="smooth-content">
        <!--==============================
        Breadcumb
        ============================== -->
        <div class="breadcumb-wrapper text-center" data-bg-src="/assets/frontOffice/img/bg/breadcrumb-bg.png">
            <!-- bg animated image/ -->   
            <div class="container">
                <div class="breadcumb-content">
                    <h1 class="breadcumb-title">Nos Galeries</h1>
                </div>
                <ul class="breadcumb-menu">
                    <li><a href="#">Exploration</a></li>
                    <li class="active">Achat</li>
                </ul>                
            </div>
        </div>

        <!--==============================
        Product Area  
        ==============================-->
        <div class="product-area-1 space overflow-hidden">          
            <div class="container">
                <div class="row">
                    <div class="col-xl-9 col-lg-8">
                        <div class="shop-sort-bar">
                            <div class="row justify-content-between align-items-center">
                                <div class="col-md-auto">
                                    <form class="woocommerce-ordering" method="get">
                                        <select name="orderby" class="single-select orderby" aria-label="Shop order">
                                            <option value="menu_order" selected="selected">Plus Récents</option>
                                            <option value="popularity">Plus Pertinents</option>
                                            <option value="rating">Pour Vous</option>
                                        </select>
                                    </form>
                                </div>
                            </div>
                        </div>
                        <div class="row gy-4">
                         {% for article in liste %}
                         
                        <!-- PARTIE AFFICHAGE DES ARTICLES --> 
                            <div class="col-lg-4 col-md-6">
                                <div class="product-card">
                                    <div class="product-img">
                                        <span class="tag">{{ article.categorie }}</span>
                                        <img src="{{ asset('uploads/images/' ~ article.contenu) }}" alt="Product Image">
                                        <div class="actions">
                                            <a href="cart.html" class="icon-btn"><i class="fas fa-shopping-cart"></i></a>
                                            <a href="wishlist.html" class="icon-btn"><i class="far fa-heart"></i></a>
                                            <a href="#QuickView-{{ article.id }}" class="icon-btn popup-content"><i class="far fa-eye"></i></a>
                                        </div>
                                    </div>
                                    <div class="product-content">
                                        <span class="price">{{ article.prix }} Dt<del>$550.00</del></span>
                                        <h3 class="product-title"><a href="shop-details.html">{{ article.titre }}</a></h3>
                                        <span class="date">{{ article.datePub|date('Y-m-d') }} </span>
                                    </div>
                                </div>
                            </div> 
                            <!-- PARTIE QUICK CHECK --> 
                                        <div id="QuickView-{{ article.id }}" class="white-popup mfp-hide">
                            <div class="container bg-white">
                                <div class="row gx-50">
                                    <div class="col-lg-6">
                                        <div class="product-big-img">
                                            <div class="img"><img src="{{ asset('uploads/images/' ~ article.contenu) }}" alt="Product Image"></div>
                                        </div>
                                    </div>
                                    <div class="col-lg-6 align-self-center">
                                        <div class="product-about">
                                            <p class="price">{{ article.prix }} Dt</p>
                                            <h2 class="product-title">{{ article.titre }}</h2>
                                            <div class="product-rating">
                                                <div class="star-rating" role="img" aria-label="Rated 5.00 out of 5"><span style="width:100%">Rated <strong class="rating">5.00</strong> out of 5 based on <span class="rating">1</span> customer rating</span></div>
                                            </div>
                                            <p class="text">{{ article.description }}</p>
                                            <div class="checklist">
                                                <ul>
                                                    <li><i class="far fa-check-circle"></i>Publié le {{ article.datePub|date('Y-m-d') }}</li>
                                                    <li><i class="far fa-check-circle"></i>Aimé par {{ article.nbrlikes }} personnes</li>
                                                </ul>
                                            </div>
                                            <div class="actions">
                                                <div class="quantity">
                                                    <input type="number" class="qty-input" step="1" min="1" max="3" name="quantity" value="1" title="Qty">
                                                    <button class="quantity-plus qty-btn"><i class="fas fa-chevron-up"></i></button>
                                                    <button class="quantity-minus qty-btn"><i class="fas fa-chevron-down"></i></button>
                                                </div>
                                                <button class="btn">Acheter<i class="fas fa-shopping-bag ms-2"></i></button>
                                            </div>
                                            <div class="product_meta">
                                                <span class="posted_in">Artist : {{ article.galerie.user.nom }} {{ article.galerie.user.prenom }}</a></span>
                                                <span class="posted_in">Category : {{ article.categorie }}</a></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <button title="Close (Esc)" type="button" class="mfp-close">×</button>
                            </div>
                        </div>
                            {% endfor %}
                                
                                             
                        </div>
                        {# Ajout de la pagination #}
                        <div class="pagination-area text-center">
                            {% if pages > 1 %}
                                <div class="pagination-container">
                                    {% if page > 1 %}
                                        <a href="{{ path(app.request.get('_route') == 'cat_article' 
                                            ? 'cat_article' 
                                            : 'app_gallerie', 
                                            app.request.get('_route') == 'cat_article' 
                                            ? {'cat': app.request.get('cat'), 'page': page - 1}
                                            : {'page': page - 1}) }}" 
                                           class="pagination-btn">
                                            <i class="fas fa-angle-left"></i>
                                        </a>
                                    {% endif %}
                                    
                                    {% for i in 1..pages %}
                                        <a href="{{ path(app.request.get('_route') == 'cat_article' 
                                            ? 'cat_article' 
                                            : 'app_gallerie',
                                            app.request.get('_route') == 'cat_article' 
                                            ? {'cat': app.request.get('cat'), 'page': i}
                                            : {'page': i}) }}" 
                                           class="pagination-btn {% if i == page %}active{% endif %}">
                                            {{ i }}
                                        </a>
                                    {% endfor %}

                                    {% if page < pages %}
                                        <a href="{{ path(app.request.get('_route') == 'cat_article' 
                                            ? 'cat_article' 
                                            : 'app_gallerie',
                                            app.request.get('_route') == 'cat_article' 
                                            ? {'cat': app.request.get('cat'), 'page': page + 1}
                                            : {'page': page + 1}) }}" 
                                           class="pagination-btn">
                                            <i class="fas fa-angle-right"></i>
                                        </a>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    <div class="col-xl-3 col-lg-4 sidebar-widget-area">
                        <aside class="sidebar-sticky-area sidebar-area sidebar-shop">
                            <div class="widget widget_categories">
                                <h3 class="widget_title">Categories</h3>
                                <ul>
                                    <li>
                                        <a href="{{ path('app_gallerie') }}">Tout</a>
                                    </li>
                                    <li>
                                        <a href="{{ path('cat_article', { 'cat': 'Peinture', 'page': 1 }) }}">Peinture</a>
                                    </li>
                                    <li>
                                        <a href="{{ path('cat_article', { 'cat': 'Sculpture', 'page': 1 }) }}">Sculpture</a>
                                    </li>
                                    <li>
                                        <a href="{{ path('cat_article', { 'cat': 'Photographie', 'page': 1 }) }}">Photographie</a>
                                    </li>
                                    <li>
                                        <a href="{{ path('cat_article', { 'cat': 'DessinEtIllustration', 'page': 1 }) }}">DessinEtIllustration</a>
                                    </li>
                                    <li>
                                        <a href="{{ path('cat_article', { 'cat': 'ArtNumerique', 'page': 1 }) }}">ArtNumerique</a>
                                    </li>  
                                    <li>
                                        <a href="{{ path('cat_article', { 'cat': 'Architecture', 'page': 1 }) }}">Architecture</a>
                                    </li>                               
                                </ul>
                            </div>
    
                            <div class="widget widget_price_filter  ">
                                <h4 class="widget_title">Filtrer par prix</h4>
                                <div class="price_slider_wrapper">
                                    <div class="price_slider"></div>
                                    <div class="price_label">
                                        Price: <span class="from">0 Dt</span> — <span class="to">100 Dt</span>
                                        <button type="submit" class="button btn">Filtrer</button>
                                    </div>
                                </div>
                            </div>
                        </aside>
                    </div>
                </div>
            </div>
        </div>
{% endblock %}