{% extends 'base2.html.twig' %}

{% block title %}Liste des Candidatures{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Liste des Candidatures</h1>

        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Candidat</th>
                    <th>Emploi</th>
                    <th>Statut</th>
                    <th>Date</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for candidatureOffre in candidatureOffres %}
                    <tr>
                        <td>{{ candidatureOffre.id }}</td>
                        <td>{{ candidatureOffre.candidature.candidat }}</td>
                        <td>{{ candidatureOffre.emploi.titre }}</td>
                        <td>{{ candidatureOffre.statut }}</td>
                        <td>{{ candidatureOffre.dateAssociation|date('Y-m-d H:i:s') }}</td>
                        <td>
                            <a href="{{ path('backoffice_candidature_offre_show', {'id': candidatureOffre.id}) }}" class="btn btn-primary btn-sm">Voir</a>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endblock %}