{% extends 'base2.html.twig' %}
{% block body %}

<div class="card-body">
    <h4 class="card-title">Basic Table</h4>
    <p class="card-description"> Add class <code>.table</code> </p>
    <div class="mb-3">
        <h1>Liste Des Galeries</h1>
    </div>
    

    <!-- Barre de recherche -->
    <div class="mb-3">
        <input type="text" id="searchInput" class="form-control" placeholder="Rechercher une galerie..." onkeyup="filterGalleries()">
    </div>
    <!-- Boutton d'ajout -->
    <div class="mb-3">
        <a href="/backAddgallerie" class="btn btn-inverse-primary btn-fw">Ajouter Galerie</a>
        <button id="exportPdfBtn" class="btn btn-inverse-success btn-fw">
            <i class="mdi mdi-file-pdf me-1"></i>Export to PDF
        </button>
    </div>

    <div class="table-responsive">
        <table class="table" id="galleryTable">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>User_id</th>
                    <th>Nom</th>
                    <th>Date de Création</th>
                    <th>Description</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for galerie in liste %}
                <tr>
                    <td>{{ galerie.id }}</td>
                    <td>{{ galerie.user.id }}</td>
                    <td>{{ galerie.nom }}</td>
                    <td>{{ galerie.datecreation|date('Y-m-d') }}</td>
                    <td>
                        {% set description = galerie.description %}
                        {% if description|length > 50 %}
                            <span class="short-desc">{{ description|slice(0, 50) }}...</span>
                            <span class="full-desc d-none">{{ description }}</span>
                            <a href="#" class="read-more btn btn-link" onclick="toggleDescription(this); return false;">Lire plus</a>
                        {% else %}
                            {{ description }}
                        {% endif %}
                    </td>
                    <td>
                        <div class="btn-group">
                            <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-toggle="dropdown">Action</button>
                            <div class="dropdown-menu">
                                <a class="btn btn-inverse-danger btn-fw" href="{{ path('delete_galerie', { 'id': galerie.id }) }}">Supprimer</a>
                                <a class="btn btn-inverse-primary btn-fw" href="{{ path('edit_galerie', { 'id': galerie.id }) }}">Modifier</a>
                                <a class="btn btn-inverse-secondary btn-fw" href="{{ path('back_showarticlebygallerie', { 'id': galerie.id }) }}">Voir Articles</a>
                            </div>
                        </div>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="pagination-container mt-3">
        <button onclick="prevPage()" class="btn btn-sm btn-primary">Précédent</button>
        <span id="page-info" class="mx-2"></span>
        <button onclick="nextPage()" class="btn btn-sm btn-primary">Suivant</button>
    </div>
</div>

<!-- 📜 Script JavaScript pour exporter le tableau en PDF -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
<script>
    function exportToPDF() {
    const table = document.getElementById("galleryTable").cloneNode(true); // Cloner le tableau
    const today = new Date();

    // Supprimer la colonne "Actions"
    let headerRow = table.getElementsByTagName("thead")[0].rows[0];
    let bodyRows = table.getElementsByTagName("tbody")[0].rows;

    headerRow.deleteCell(headerRow.cells.length - 1); // Supprimer la colonne "Actions" dans l'en-tête

    for (let row of bodyRows) {
        row.deleteCell(row.cells.length - 1); // Supprimer la colonne "Actions" dans chaque ligne
    }

    // Configuration des options du PDF
    const opt = {
        margin: [0.5, 0.5],
        filename: `galeries-${today.toISOString().split('T')[0]}.pdf`,
        image: { type: 'jpeg', quality: 1 },
        html2canvas: { scale: 2, useCORS: true, logging: false },
        jsPDF: { unit: 'in', format: 'a4', orientation: 'landscape' }
    };

    // Désactiver le bouton et afficher l'animation de chargement
    const button = document.getElementById('exportPdfBtn');
    const originalText = button.innerHTML;
    button.innerHTML = '<i class="mdi mdi-loading mdi-spin me-1"></i> Génération en cours...';
    button.disabled = true;

    // Générer le PDF
    html2pdf().set(opt).from(table).save()
        .then(() => {
            button.innerHTML = originalText;
            button.disabled = false;
        })
        .catch(error => {
            console.error('Erreur lors de la génération du PDF:', error);
            button.innerHTML = originalText;
            button.disabled = false;
            alert('Une erreur est survenue lors de la création du PDF.');
        });
}

    // Attacher l'événement au bouton
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('exportPdfBtn').addEventListener('click', exportToPDF);
    });
</script>





<!-- 📜 Script JavaScript pour la recherche -->
<script>
    function filterGalleries() {
        let input = document.getElementById("searchInput").value.toLowerCase();
        let table = document.getElementById("galleryTable");
        let rows = table.getElementsByTagName("tr");

        for (let i = 1; i < rows.length; i++) {  // Commence à 1 pour ignorer l'en-tête
            let rowText = rows[i].textContent.toLowerCase();
            if (rowText.includes(input)) {
                rows[i].style.display = "";
            } else {
                rows[i].style.display = "none";
            }
        }
    }

</script>
<!-- Script JavaScript pour la pagination -->
<script>
    let currentPage = 1;
    const rowsPerPage = 3;

    function paginateTable() {
        let table = document.getElementById("galleryTable");
        let tbody = table.getElementsByTagName("tbody")[0];
        let rows = tbody.getElementsByTagName("tr");
        let totalRows = rows.length;
        let totalPages = Math.ceil(totalRows / rowsPerPage);

        // Masquer toutes les lignes
        for (let i = 0; i < totalRows; i++) {
            rows[i].style.display = "none";
        }

        // Afficher uniquement les lignes de la page actuelle
        let start = (currentPage - 1) * rowsPerPage;
        let end = start + rowsPerPage;
        for (let i = start; i < end && i < totalRows; i++) {
            rows[i].style.display = "";
        }

        // Mise à jour des boutons
        document.getElementById("page-info").textContent = `Page ${currentPage} / ${totalPages}`;
    }

    function prevPage() {
        if (currentPage > 1) {
            currentPage--;
            paginateTable();
        }
    }

    function nextPage() {
        let table = document.getElementById("galleryTable");
        let totalRows = table.getElementsByTagName("tbody")[0].getElementsByTagName("tr").length;
        let totalPages = Math.ceil(totalRows / rowsPerPage);
        if (currentPage < totalPages) {
            currentPage++;
            paginateTable();
        }
    }

    document.addEventListener("DOMContentLoaded", paginateTable);
</script>

{% endblock %}
